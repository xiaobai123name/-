# ============================================
# 环境变量配置模板
# 复制此文件为 .env 并填写实际的API密钥
# ============================================

# === Google Gemini API ===
GOOGLE_API_KEY=your_gemini_api_key_here

# === Antigravity 反代（OpenAI 兼容）===
# 用途：当直连受限时，通过 Antigravity 统一转发到 Gemini/Claude 等模型
# 注意：API Base 一般形如 https://xxx/api/v1 或 https://xxx/v1（必须包含 /v1 路径）
ANTIGRAVITY_API_KEY=sk-81e9a38a0a49493ba63304d6b731c828
ANTIGRAVITY_API_BASE=http://127.0.0.1:8045/v1

# === LlamaParse API (PDF解析) ===
LLAMA_CLOUD_API_KEY=your_llamaparse_api_key_here

# === 硅基流动 API (Reranker) ===
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# === 数据库配置 ===
DATABASE_PATH=data/learning_companion.db

# === ChromaDB配置 ===
CHROMA_PERSIST_DIR=data/chroma_db

# === 文档上传配置 ===
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=50

# === 模型配置 ===
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PROVIDER=google

# === RAG配置 ===
CHUNK_SIZE=500
CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=2000
TOP_K_RETRIEVAL=10
RERANK_TOP_K=5
CONFIDENCE_THRESHOLD=0.15

# === 知识图谱性能/限速配置 ===
# 说明：
# - KG_LLM_TARGET_RPM / KG_EMBED_TARGET_RPM 为目标速率（0=关闭）
# - 若设置了 KG_LLM_TARGET_RPM，会与 KG_MIN_REQUEST_INTERVAL_SEC 取更保守值
KG_MIN_REQUEST_INTERVAL_SEC=4.0
KG_LLM_TARGET_RPM=4
KG_EMBED_TARGET_RPM=80
KG_MULTI_DOC_STRATEGY=per_doc

# === 应用配置 ===
APP_TITLE=智能学习伴侣
APP_LANGUAGE=zh-CN
DEBUG=false
